# ==============================================================================
# Pocket TTS Studio - Konfiguration
# ==============================================================================

# 1. Hugging Face Token (Erforderlich für eigenes Voice Cloning)
# Gehe auf https://huggingface.co/kyutai/pocket-tts, akzeptiere die Bedingungen
# und trage deinen Token hier ein:
HF_TOKEN=

# 2. Standard-Sprachmodell beim Start:
# Optionen: german_24l (Standard für Deutsch), english, french_24l, spanish_24l, italian_24l, portuguese_24l
DEFAULT_LANGUAGE=german_24l

# 3. HTTP Port (Standard: 8000)
PORT=8000

# 4. Optional: Host-Cache für Hugging Face Models
# Falls nicht gesetzt, verwendet Docker automatisch ein eigenes persistentes Docker-Volume (huggingface_cache).
# Wenn du den Cache deines Host-Systems teilen möchtest, entferne das '#' und passe den Pfad an:
# Mac/Linux:
# HF_CACHE_DIR=~/.cache/huggingface
# Windows:
# HF_CACHE_DIR=C:/Users/DeinBenutzer/.cache/huggingface
